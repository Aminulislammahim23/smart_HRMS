@smartHRMS.Api_HostAddress = http://localhost:5099
@employeeId = 00000000-0000-0000-0000-000000000000
@departmentId = 00000000-0000-0000-0000-000000000000
@designationId = 00000000-0000-0000-0000-000000000000
@documentId = 00000000-0000-0000-0000-000000000000
@recordId = 00000000-0000-0000-0000-000000000000

### Health
GET {{smartHRMS.Api_HostAddress}}/api/health
Accept: application/json

### List employees
GET {{smartHRMS.Api_HostAddress}}/api/employees
Accept: application/json

### Get employee by id
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}
Accept: application/json

### Create employee (replace the two ids with existing department/designation ids)
POST {{smartHRMS.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "employeeCode": "EMP-100",
  "firstName": "Jane",
  "lastName": "Doe",
  "email": "jane.doe@example.com",
  "phone": "+8801711000100",
  "employmentType": "FullTime",
  "basicSalary": 55000,
  "dateOfBirth": "1990-01-01",
  "joiningDate": "2024-01-01",
  "departmentId": "{{departmentId}}",
  "designationId": "{{designationId}}"
}

### Update employee (full update; omit "status"/"employmentType" to keep them. Setting "status" to Active/OnLeave reactivates)
PUT {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}
Content-Type: application/json

{
  "firstName": "Jane",
  "lastName": "Doe",
  "email": "jane.doe@example.com",
  "phone": "+8801711000100",
  "dateOfBirth": "1990-01-01",
  "joiningDate": "2024-01-01",
  "departmentId": "{{departmentId}}",
  "designationId": "{{designationId}}",
  "employmentType": "FullTime",
  "status": "Active"
}

### Deactivate employee
DELETE {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}

### Upload/replace employee photo (.jpg/.jpeg/.png/.webp, up to 5 MB)
PUT {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/photo
Content-Type: multipart/form-data; boundary=----photoBoundary

------photoBoundary
Content-Disposition: form-data; name="photo"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------photoBoundary--

### Remove employee photo
DELETE {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/photo

### List departments
GET {{smartHRMS.Api_HostAddress}}/api/departments
Accept: application/json

### Create department
POST {{smartHRMS.Api_HostAddress}}/api/departments
Content-Type: application/json

{
  "name": "Information Technology",
  "description": "Software, infrastructure and IT support"
}

### Update department (isActive is required; false = deactivate, blocked while current employees are assigned)
PUT {{smartHRMS.Api_HostAddress}}/api/departments/{{departmentId}}
Content-Type: application/json

{
  "name": "Information Technology",
  "description": "Software, infrastructure and IT support",
  "isActive": true
}

### Deactivate department (soft delete; 409 while active or on-leave employees are assigned)
DELETE {{smartHRMS.Api_HostAddress}}/api/departments/{{departmentId}}

### List designations
GET {{smartHRMS.Api_HostAddress}}/api/designations
Accept: application/json

### Create designation
POST {{smartHRMS.Api_HostAddress}}/api/designations
Content-Type: application/json

{
  "name": "Software Engineer",
  "description": "Develops and maintains software applications"
}

### Update designation
PUT {{smartHRMS.Api_HostAddress}}/api/designations/{{designationId}}
Content-Type: application/json

{
  "name": "Software Engineer",
  "description": "Develops and maintains software applications",
  "isActive": true
}

### Deactivate designation (soft delete; 409 while active or on-leave employees are assigned)
DELETE {{smartHRMS.Api_HostAddress}}/api/designations/{{designationId}}

### Employee profile (personal + job information, photo, active documents)
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/profile
Accept: application/json

### List employee documents (add ?includeInactive=true to include deactivated ones)
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents
Accept: application/json

### Upload employee document
### documentType: Nid, Passport, BirthCertificate, EducationalCertificate, ExperienceCertificate, JoiningLetter, Cv, TinCertificate, ContractPaper, Other
### documentName is required; issueDate/expiryDate (yyyy-MM-dd) and description are optional.
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents
Content-Type: multipart/form-data; boundary=----docBoundary

------docBoundary
Content-Disposition: form-data; name="documentType"

Nid
------docBoundary
Content-Disposition: form-data; name="documentName"

National ID card
------docBoundary
Content-Disposition: form-data; name="issueDate"

2020-05-01
------docBoundary
Content-Disposition: form-data; name="description"

National ID card
------docBoundary
Content-Disposition: form-data; name="file"; filename="nid.pdf"
Content-Type: application/pdf

< ./nid.pdf
------docBoundary--

### Get one document's metadata
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents/{{documentId}}
Accept: application/json

### Download a document
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents/{{documentId}}/download

### Update a document's metadata (the file is not changed). Omitted documentType/documentName keep their value;
### omitted issueDate/expiryDate/description are cleared.
PUT {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents/{{documentId}}
Content-Type: application/json

{
  "documentType": "Passport",
  "documentName": "Passport",
  "issueDate": "2021-03-10",
  "expiryDate": "2031-03-09",
  "description": "Passport copy"
}

### Deactivate (soft delete) a document
DELETE {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/documents/{{documentId}}

### ---------- Day 11: employee profile records ----------

### Personal details (one per employee)
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/personal-details

### Create personal details (409 if they already exist; use PUT)
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/personal-details
Content-Type: application/json

{
  "gender": "Female",
  "maritalStatus": "Married",
  "bloodGroup": "OPositive",
  "nationality": "Bangladeshi",
  "nationalId": "1234567890123",
  "passportNo": "AB1234567"
}

### Update personal details (full update)
PUT {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/personal-details
Content-Type: application/json

{
  "gender": "Female",
  "maritalStatus": "Married",
  "bloodGroup": "OPositive",
  "nationality": "Bangladeshi",
  "nationalId": "1234567890123"
}

### Addresses
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/addresses

### Add an address (at most one Present and one Permanent)
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/addresses
Content-Type: application/json

{
  "addressType": "Present",
  "address": "House 12, Road 2",
  "city": "Dhaka",
  "district": "Dhaka",
  "postalCode": "1207"
}

### Emergency contacts
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/emergency-contacts

### Add an emergency contact
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/emergency-contacts
Content-Type: application/json

{
  "name": "John Doe",
  "relationship": "Spouse",
  "phone": "+8801800000100",
  "email": "john.doe@example.com"
}

### Education
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/educations

### Add an education record
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/educations
Content-Type: application/json

{
  "degree": "BSc",
  "institution": "University of Dhaka",
  "major": "Computer Science",
  "result": "CGPA 3.80",
  "passingYear": 2017
}

### Experience
GET {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/experiences

### Add an experience record (omit endDate for a current job)
POST {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/experiences
Content-Type: application/json

{
  "companyName": "Acme Ltd",
  "designation": "Software Engineer",
  "startDate": "2018-01-01",
  "endDate": "2022-12-31",
  "responsibilities": "Backend development"
}

### Update / delete any profile record by id (replace "addresses" with the resource)
DELETE {{smartHRMS.Api_HostAddress}}/api/employees/{{employeeId}}/addresses/{{recordId}}
