# Origin of the SmartHRMS API (no trailing slash). The API must list this app's origin in Cors:AllowedOrigins.
# Leave empty to call the same origin the app is served from; the Vite dev/preview server then proxies
# /api and /uploads to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=http://localhost:5099

# Only used when VITE_API_BASE_URL is empty.
VITE_API_PROXY_TARGET=http://localhost:5099
